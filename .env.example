# Leave the Firebase values empty to run in Demo mode (data in the browser, no setup).
# Fill them from Firebase console > Project settings > Your apps > Web app to use Firebase (free Spark plan).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Force demo mode even when Firebase keys are present: local
VITE_DATA_MODE=

# Optional: change the demo keys (issuer signing seed, field-encryption key, contact-matching salt).
# In production the issuer key lives in an HSM / Cloud KMS and signing runs on the server.
VITE_ISSUER_SEED=
VITE_DATA_KEY=
VITE_MATCH_SALT=

# Use the local Firebase emulators (firebase emulators:start)
VITE_USE_EMULATOR=false
